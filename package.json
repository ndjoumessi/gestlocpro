{
  "name": "gestlocpro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "check": "tsc -b && oxlint && node scripts/check-i18n.mjs && node scripts/check-orphelins.mjs && node scripts/check-montants.mjs && vitest run && node scripts/mesure-ui.mjs && node scripts/couleur-non-seule.mjs && node scripts/stabilite-au-pointage.mjs && node scripts/plafond-coquille.mjs && node scripts/modales.mjs && node scripts/plafond-vitrine.mjs && node scripts/series-lisibles.mjs && node scripts/photo-transcodage.mjs && node scripts/chasses-helvetica.mjs && node scripts/decisions-nommees.mjs && node scripts/poids-ecrans.mjs",
    "check:server": "npm --prefix server run check",
    "check:all": "npm run check && npm run check:server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:orphelins": "node scripts/check-orphelins.mjs",
    "lint:montants": "node scripts/check-montants.mjs",
    "mesure": "node scripts/mesure-ui.mjs",
    "inventaire": "node scripts/inventaire-ui.mjs",
    "poids": "node scripts/poids-ecrans.mjs",
    "lint:couleur": "node scripts/couleur-non-seule.mjs",
    "stabilite": "node scripts/stabilite-au-pointage.mjs",
    "coquille": "node scripts/plafond-coquille.mjs",
    "releve": "node scripts/releve-refonte.mjs",
    "modales": "node scripts/modales.mjs",
    "vitrine": "node scripts/plafond-vitrine.mjs",
    "series": "node scripts/series-lisibles.mjs",
    "chasses": "node scripts/chasses-helvetica.mjs",
    "decisions": "node scripts/decisions-nommees.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.1.14",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
