{
  "name": "gestlocpro-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "prisma migrate deploy && node dist/src/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "relances:auto": "tsx src/scripts/executerRelancesAutomatiques.ts",
    "relances:blanc": "tsx src/scripts/executerRelancesAutomatiques.ts --a-blanc",
    "test": "vitest run",
    "check": "tsc -b && node scripts/verifier-le-chargement-node.mjs && vitest run",
    "db:test:setup": "prisma generate && node scripts/setup-test-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
