# Environnement des TESTS SERVEUR. Versionné : il ne contient aucun secret, et
# tout le monde doit viser la même base.
#
# Il existe parce que la suite EFFACE ce qu'elle trouve — `park.deleteMany()` et
# `userAccount.deleteMany()` avant CHAQUE cas. Tant que `DATABASE_URL` pointait
# sur `gestlocpro`, lancer les tests vidait la base de développement : un parc,
# ses immeubles, ses baux et le compte qui les possède, sans un mot.
#
# La base `gestlocpro_test` vit dans le MÊME conteneur : rien de plus à démarrer
# que `npm run db:up`. Elle est créée et migrée par `npm run db:test:setup`.
DATABASE_URL="postgresql://gestlocpro:gestlocpro@localhost:5433/gestlocpro_test?schema=public"

SESSION_SECRET="test-secret-sans-consequence"
NODE_ENV="test"
