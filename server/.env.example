# Copier en `.env` — ce fichier-ci est versionné, `.env` ne l'est pas.

# Base de développement, démarrée par `docker compose up -d` à la racine.
# Port 5433 : une installation locale de PostgreSQL occupe souvent le 5432.
DATABASE_URL="postgresql://gestlocpro:gestlocpro@localhost:5433/gestlocpro?schema=public"

# Secret de signature des cookies de session.
# En développement une valeur quelconque suffit ; en production elle doit être
# tirée au hasard et tenue hors du dépôt. Le serveur REFUSE de démarrer si elle
# vaut encore celle-ci hors développement — un secret par défaut en production
# est une porte ouverte, et le silence est ici le vrai danger.
SESSION_SECRET="dev-secret-a-remplacer"

PORT=3001

# Origine du client Vite, pour la politique CORS.
CLIENT_ORIGIN="http://localhost:5173"
