// Schéma de persistance de GestLocPro.
//
// ─────────────────────────────────────────────────────────────────────────────
// Ce que ce schéma corrige par rapport au modèle client
// ─────────────────────────────────────────────────────────────────────────────
//
// Le modèle de `src/data/portfolio.ts` a été taillé pour une démonstration
// mono-utilisateur tenue dans un onglet. Cinq de ses raccourcis ne survivent
// pas au passage au serveur, et chacun se paie ici :
//
//   1. Aucune entité ne porte de propriétaire. Deux comptes sur le même
//      navigateur partagent aujourd'hui le même parc. Tout se rattache
//      désormais à un `Park`, directement ou par jointure.
//   2. Un paiement est un événement, pas un champ. `Unit.status` confond
//      « y a-t-il un bail ? » et « où en est l'échéance du mois ? ». La
//      première est l'existence d'un `Lease` courant, la seconde un calcul sur
//      `RentCharge` et `Payment`. L'énumération à cinq valeurs survit comme
//      projection d'affichage, jamais comme colonne.
//   3. Les noms en clair remplacent les relations : `Unit.tenant` et
//      `Deposit.tenant` portent deux copies du même nom, déjà libres de
//      diverger, et leur `null` ne veut pas dire la même chose dans les deux
//      tables. Un `Tenant` est une personne, un `Lease` est une relation datée.
//   4. Les identifiants sont lisibles par l'humain — `A1`, `SIG-2026-042`. Ils
//      ne sont uniques que parce qu'il n'y a qu'un propriétaire. Clés `uuid`,
//      et « A1 » devient un `label` unique par immeuble.
//   5. Les compteurs sont stockés au lieu d'être comptés : `Building.occupied`
//      se contredisait déjà avec l'écran Parc. Aucun compteur ici.
//
// ─────────────────────────────────────────────────────────────────────────────
// Deux conventions qui portent tout le reste
// ─────────────────────────────────────────────────────────────────────────────
//
// **L'argent est un entier d'unités mineures, plus une devise.** Jamais un
// flottant : 0,1 + 0,2 ne vaut pas 0,3 en binaire, et une comptabilité qui
// dérive d'un centime par ligne est indéfendable. La devise vit sur le `Park`
// et non sur la session — le sélecteur de l'interface reste une préférence
// d'affichage. `CFA` n'est pas un code ISO 4217, le code client le dit
// lui-même : le stockage tranche `XAF` ou `XOF`, que le pays permet de
// retrouver, et l'affichage les réunit sous « FCFA ».
//
// **Le temps est en `date` ou `timestamptz`, jamais en pièces détachées.** Le
// client stockait `DateParts` avec un mois indexé à zéro — un artefact du
// langage promu au rang de donnée — et `RelativeStamp { value: -2 }`, un
// décalage figé qui n'a jamais vieilli. Le relatif se calcule à l'affichage,
// comme `lib/dates` le fait déjà.

// Le générateur de Prisma 7. `prisma-client-js` a disparu avec la version 6.
//
// Il émet du TYPESCRIPT dans l'arbre des sources, et non du JavaScript dans
// `node_modules` : le client cesse d'être un artefact caché que `npm install`
// fabrique en silence, il devient du code que `tsc` compile avec le reste. Le
// chemin de sortie est désormais OBLIGATOIRE — Prisma 7 refuse de deviner.
//
// Sous `src/` pour que `tsc -b` l'emporte dans `dist` : le conteneur exécute
// `node dist/src/index.js`, et un client resté hors de `dist` s'y chercherait
// en vain. Il reste ignoré par git : c'est une sortie de compilation, pas une
// source. Un `postinstall` avait été envisagé pour le régénérer, et il ne
// pouvait pas tenir — `npm ci` s'exécute AVANT que le schéma ne soit copié dans
// l'image, et sans `DATABASE_URL`. La génération vit donc à deux endroits
// nommés : `db:test:setup`, la commande qu'on lance après un changement de
// schéma, et la ligne `RUN` du Dockerfile pour l'image.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Les imports du client généré portent leur EXTENSION.
  //
  // Sans elle, le générateur écrit `from './enums'` : TypeScript l'accepte,
  // `tsc` le recopie tel quel dans `dist/`, et Node le refuse au démarrage —
  // « Cannot find module .../generated/prisma/enums ». Le fichier est pourtant
  // là, à l'extension près : la résolution ESM de Node, elle, ne devine pas.
  //
  // Le défaut n'apparaît qu'en PRODUCTION. Vitest a son propre résolveur et
  // avale l'import nu ; les deux portes du dépôt passaient donc au vert sur un
  // serveur que Node refusait de charger. C'est ce qui a fait échouer le
  // déploiement de la montée en version — le conteneur redémarrait en boucle
  // pendant que `migrate deploy` s'exécutait correctement juste avant.
  importFileExtension = "js"
}

// L'URL a quitté ce fichier : Prisma 7 la refuse ici. Elle vit dans
// `prisma.config.ts` pour les commandes de migration, et arrive au client par
// son ADAPTATEUR de pilote — voir `src/db.ts`. Le schéma ne décrit plus que la
// forme des données, jamais où les joindre.
datasource db {
  provider = "postgresql"
}

// ─── Identité et accès ───────────────────────────────────────────────────────

/// Une personne, indépendamment de ses rôles.
///
/// L'inscription valide neuf champs puis les jette : le produit n'a aucun
/// compte, et le sélecteur de profil de `AppShell` tient lieu
/// d'authentification. C'est ici qu'une personne existe pour la première fois —
/// condition pour qu'un même humain soit propriétaire d'un parc et locataire
/// d'un autre, ce que le modèle actuel ne sait pas exprimer.
model UserAccount {
  id       String @id @default(uuid()) @db.Uuid
  /// Identifiant de connexion. Comparé en minuscules : l'utilisateur qui
  /// s'inscrit en « Sarah@... » et se connecte en « sarah@... » est la même
  /// personne, et lui refuser l'accès serait incompréhensible.
  email    String @unique
  passwordHash String
  fullName String
  /// Normalisé E.164 (+237677214408). Le client fabriquait une chaîne
  /// d'affichage en concaténant l'indicatif et les espaces — du formatage figé
  /// dans la donnée, le défaut déjà corrigé pour les dates et les montants.
  phoneE164 String?
  /// ISO 3166-1 alpha-2. Pilote le format des dates via `resolveDateLocale`.
  countryCode String? @db.Char(2)
  locale   Locale @default(fr)

  /// Juridiquement la première chose à conserver, avec sa date. La case bloque
  /// l'inscription et n'était enregistrée nulle part.
  termsAcceptedAt DateTime
  newsletterOptIn Boolean  @default(false)
  /// Les COPIES e-mail du fil d'un signalement. Vrai par défaut : un défaut à
  /// faux couperait tout le monde à la seconde du déploiement, alors que ces
  /// copies partent déjà. Se désabonner retire la COPIE, jamais la
  /// notification — l'avis reste dans le produit, on renonce à un doublon et
  /// pas à l'information. Sur le COMPTE et non sur le parc : le choix
  /// appartient à qui reçoit, et vaut partout où il est membre.
  threadEmailOptIn Boolean @default(true)
  /// GROUPER les copies plutôt que de les recevoir une à une. Faux par
  /// défaut : l'écran du locataire promet que son signalement est reçu
  /// IMMÉDIATEMENT, et un résumé imposé rendrait cette phrase fausse pour
  /// tout le monde. C'est un choix de celui qui reçoit, jamais un réglage du
  /// parc — et il ne touche que la COPIE : l'avis dans le produit reste
  /// immédiat.
  threadEmailDigest Boolean @default(false)
  /// Jusqu'où le dernier résumé est allé. Nul tant qu'aucun n'est parti — le
  /// premier prend alors tout ce que le compte a reçu. Sans cette borne,
  /// chaque passage renverrait l'historique entier.
  lastThreadDigestAt DateTime?
  /// On désactive, on ne supprime pas : cette personne est citée par des baux,
  /// des paiements et des décisions d'arbitrage.
  disabledAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions     Session[]
  memberships  Membership[]
  tenantProfile Tenant?
  passwordResets PasswordReset[]
  invitationsSent Invitation[]  @relation("InvitationIssuer")
  auditEvents   AuditEvent[]
  approvedWorks WorkOrder[]     @relation("WorkApprover")
  reportedWorks WorkOrder[]     @relation("WorkReporterAccount")
  settledDeposits Deposit[]     @relation("DepositSettler")
  recordedPayments Payment[]    @relation("PaymentRecorder")
  capturedReadings MeterReading[] @relation("ReadingCapturer")
  documentRequests DocumentRequest[] @relation("DocumentRequester")
  resolvedDocumentRequests DocumentRequest[] @relation("DocumentResolver")

  @@index([disabledAt])
}

/// Session opaque. Seule l'empreinte du jeton est conservée.
///
/// Une fuite de cette table ne livre alors aucune session utilisable, comme une
/// fuite des comptes ne livre aucun mot de passe. Voir `src/auth/token.ts` pour
/// le raisonnement complet, et pourquoi ce n'est pas un JWT.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 du jeton remis au client. Le jeton lui-même n'existe que dans le
  /// cookie.
  tokenHash    String   @unique
  expiresAt    DateTime
  /// « Rester connecté sur cet appareil ». `false` quand l'utilisateur a
  /// décoché la case : le cookie meurt avec le navigateur ET l'échéance
  /// ci-dessus se compte en heures. Écrite ici parce qu'un cookie de session
  /// ne suffit pas — les navigateurs les restaurent quand « reprendre là où
  /// vous en étiez » est actif, et il l'est souvent par défaut.
  ///
  /// Le défaut vaut `true` : les sessions déjà ouvertes gardent exactement la
  /// durée qu'elles avaient, et un client plus ancien qui n'envoie pas le
  /// champ ne déconnecte personne.
  persistent   Boolean  @default(true)
  /// Glissante : rafraîchie à chaque requête servie.
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?

  @@index([userId])
  @@index([expiresAt])
}

/// Jeton de réinitialisation de mot de passe, à usage unique.
///
/// Le parcours existe déjà côté client (`routes/ResetPassword.tsx`) avec un
/// jeton de démonstration en dur. Un vrai jeton doit expirer et se consommer :
/// sans cela, un lien retrouvé dans une boîte mail six mois plus tard ouvre
/// encore le compte.
model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Parc et appartenances ───────────────────────────────────────────────────

/// Un parc immobilier : l'unité de possession et de cloisonnement.
///
/// Chaque requête porte un prédicat sur ce parc. C'est ce qui remplace le blob
/// unique de `localStorage`, qui n'avait aucune identité.
model Park {
  id       String   @id @default(uuid()) @db.Uuid
  name     String
  countryCode String @db.Char(2)
  /// Devise de tenue des comptes. Elle appartient au parc : un loyer de Douala
  /// est en francs CFA, quelle que soit la langue de celui qui le regarde.
  currency Currency

  /// Les montants de ce parc sont-ils écrits en unités MINEURES ?
  ///
  /// Vrai partout depuis la migration `montants_en_unites_mineures`, et c'est un
  /// TÉMOIN de conversion, pas un réglage : le client ne compte que d'une façon
  /// à la fois. Il existe parce qu'une multiplication par cent n'est pas
  /// rejouable — l'appliquer deux fois est irréparable sans sauvegarde — et
  /// qu'une garde en base vaut mieux qu'une consigne dans un fichier.
  amountsAreMinor Boolean @default(true)
  /// Politique de délégation. Lue aujourd'hui dans un `useState` local de
  /// l'écran d'onboarding, alors qu'elle commande deux droits réels — valider
  /// un devis, arbitrer une caution. Le serveur s'en sert pour autoriser.
  delegation DelegationMode @default(delegate)
  /// Combien de MOIS un locataire parti garde ses quittances. Trois par
  /// défaut — le temps de récupérer ses pièces, de contester une retenue de
  /// caution, de fournir une attestation. Réglable PAR PARC parce qu'une
  /// législation locale peut exiger davantage, et que ce nombre est une règle
  /// de gestion, pas une constante d'implémentation.
  leaseAccessMonths Int @default(3)
  /// La relance automatique de loyer, allumée ou éteinte POUR CE PARC.
  /// Allumée par défaut : elle existait déjà en code, et un défaut à faux
  /// l'aurait éteinte pour tout le monde au moment où elle se met enfin à
  /// tourner.
  autoReminders Boolean @default(true)
  /// Au bout de combien de JOURS de retard elle part. Sept par défaut, et le
  /// motif reste celui du code : « ni le délai serré de J+1, ni la sévérité de
  /// J+15 ». Il cesse seulement d'être une fatalité — un bailleur qui relance
  /// à trois jours n'a pas tort, il a un autre parc.
  reminderMilestoneDays Int @default(7)
  /// À quelle HEURE le passage quotidien relance ce parc, et dans quel fuseau
  /// cette heure se lit.
  ///
  /// Le cron passe désormais toutes les heures et ne fait rien pour les parcs
  /// dont ce n'est pas l'heure. C'est ce qui rend l'heure réglable depuis le
  /// produit : la planification ne sait plus QUAND envoyer, seulement quand
  /// REGARDER.
  ///
  /// `6` et `UTC` par défaut, et ce couple n'est pas neutre : c'est exactement
  /// l'heure à laquelle le cron partait jusqu'ici. Aucun parc ne change d'heure
  /// au moment où le réglage apparaît.
  ///
  /// LE FUSEAU EST INSÉPARABLE DE L'HEURE. « 7 h » ne veut rien dire sans lui,
  /// et il ne se déduit pas du pays : ce parc-ci porte `FR` et loue à Yaoundé.
  /// C'est le fuseau de qui REÇOIT qui compte, jamais celui de qui administre.
  reminderHour Int @default(6)
  reminderTimeZone String @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  buildings   Building[]
  tenants     Tenant[]
  invitations Invitation[]
  tariffs     UtilityTariff[]
  notifications Notification[]
  auditEvents AuditEvent[]
  /// Compteur de références lisibles, par année. Voir `WorkOrder.reference`.
  workCounters WorkReferenceCounter[]
}

/// Rattachement d'une personne à un parc, avec son rôle.
///
/// Le rôle était un `useState<Role>('owner')` dans la coquille applicative : un
/// attribut de l'écran, pas de quelqu'un. Il devient une relation, et c'est le
/// serveur qui la lit — masquer un bouton ne protège rien.
model Membership {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  user    UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkId  String @db.Uuid
  park    Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  role    ParkRole
  /// Voir `ScopeMode`. `wholePark` par défaut, pour les adhésions d'avant ;
  /// une adhésion créée par invitation naît `declared`.
  scope  ScopeMode @default(wholePark)
  /// `requested` porte la « demande d'accès » du gestionnaire sans code : c'est
  /// une décision en attente chez le propriétaire, pas un booléen de formulaire.
  status  MembershipStatus @default(active)
  /// Raison sociale du gestionnaire, collectée à l'inscription.
  company String?
  /// Les immeubles CONFIÉS à cette personne. Voir `MembershipBuilding`.
  buildings MembershipBuilding[]
  /// Les LOGEMENTS confiés, quand la maille de l'immeuble est trop large. Le
  /// périmètre est l'UNION des deux ; vide des deux côtés = tout le parc.
  units MembershipUnit[]
  createdAt DateTime @default(now())

  /// Une personne n'a qu'un rôle par parc : être à la fois propriétaire et
  /// gestionnaire du même parc n'a pas de sens, et rendrait l'autorisation
  /// ambiguë au lieu de la cumuler.
  @@unique([userId, parkId])
  @@index([parkId, role])
}

/// LE PÉRIMÈTRE D'UN GESTIONNAIRE — les immeubles qu'on lui a confiés.
///
/// `Park.delegation` valait `solo` ou `delegate` : tout ou rien, à l'échelle du
/// parc. Un propriétaire de trois immeubles qui confie le premier à un cabinet
/// lui ouvrait les trois — baux, loyers, impayés et cautions de logements dont
/// ce cabinet n'a jamais entendu parler.
///
/// VIDE VEUT DIRE « TOUT LE PARC », et le sens inverse serait plus intuitif.
/// Il est INAPPLICABLE : cette migration ne confie rien à personne, et « aucun
/// immeuble confié = rien à voir » aveuglerait, à la seconde du déploiement,
/// tous les gestionnaires déjà en place. L'absence de restriction est donc
/// l'état par défaut, comme `delegation: delegate` l'est déjà.
///
/// UNE TABLE NOMMÉE plutôt qu'une relation implicite : elle porte sa date, elle
/// se lit dans une sauvegarde, et le registre des décisions peut la citer.
/// Confier un immeuble donne la main sur des loyers et des cautions ; c'est un
/// fait à consigner, pas un réglage d'affichage.
///
/// LE RÔLE N'EST PAS DANS LA CLÉ, et c'est voulu : un propriétaire n'est jamais
/// borné, quoi qu'il y ait ici. La lecture du périmètre l'ignore explicitement,
/// plutôt que de compter sur le fait que personne n'écrira jamais de ligne pour
/// lui — une garde qui repose sur ce que personne ne fera n'en est pas une.
model MembershipBuilding {
  membershipId String @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  buildingId   String @db.Uuid
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([membershipId, buildingId])
  @@index([buildingId])
}

/// UN LOGEMENT CONFIÉ, quand l'immeuble est une maille trop large.
///
/// `MembershipBuilding` a posé le périmètre à l'immeuble, et l'a motivé : « on
/// confie un immeuble à un gestionnaire, pas trois appartements sur huit ».
/// C'est la maille du métier dans le cas général, et elle laisse dehors le cas
/// qui existe vraiment : un propriétaire qui confie DEUX studios d'une résidence
/// dont il garde le reste.
///
/// LES DEUX MAILLES SE CUMULENT, elles ne se remplacent pas. Le périmètre d'un
/// gestionnaire est l'UNION de ses immeubles et de ses logements ; l'une ne
/// borne jamais l'autre, et vide des deux côtés vaut toujours « tout le parc ».
///
/// CE QU'UN LOGEMENT CONFIÉ NE DONNE PAS : l'immeuble qui le porte APPARAÎT —
/// un logement sans son immeuble n'a ni nom ni quartier — mais vide de ses
/// autres logements. Voir le contenant n'est pas voir le contenu. Et créer un
/// logement dans cet immeuble reste refusé : on ne le tient pas.
model MembershipUnit {
  membershipId String @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unitId       String @db.Uuid
  unit         Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  /// EXCLU plutôt que confié. « Tout l'immeuble sauf le rez-de-chaussée » ne
  /// se disait qu'en listant les autres logements — et cette liste ne SUIT pas
  /// l'immeuble : le logement ajouté le mois suivant n'y figure pas.
  /// L'exclusion inverse le sens : l'immeuble confié suit sa croissance, le
  /// retranché reste retranché. Une colonne et non une table : les deux sens
  /// sont le même rattachement, lu à l'endroit ou à l'envers.
  exclue Boolean @default(false)

  @@id([membershipId, unitId])
  @@index([unitId])
}

/// Invitation à rejoindre un parc — locataire ou gestionnaire.
///
/// Le produit affiche un format (`LOC-XXXX-XXXX`), annonce un canal (SMS) et
/// promet que le propriétaire le communique. Rien ne les émet ni ne les
/// consomme. Un code d'invitation est un secret porteur : usage unique et
/// péremption ne sont pas optionnels.
model Invitation {
  id        String @id @default(uuid()) @db.Uuid
  parkId    String @db.Uuid
  park      Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  role      ParkRole
  /// Seule l'empreinte est stockée, comme pour les sessions : le code lisible
  /// part par SMS et n'est jamais relu depuis la base.
  codeHash  String @unique
  /// Quatre derniers caractères, pour que le propriétaire reconnaisse le code
  /// qu'il a envoyé sans que la base permette de le rejouer.
  codeHint  String
  email     String?
  phoneE164 String?
  /// Renseigné quand l'invitation vise une unité précise (cas locataire).
  unitId    String? @db.Uuid
  unit      Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  issuedById String @db.Uuid
  issuedBy   UserAccount @relation("InvitationIssuer", fields: [issuedById], references: [id])
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([parkId, role])
  @@index([expiresAt])
}

// ─── Biens ───────────────────────────────────────────────────────────────────

model Building {
  id       String @id @default(uuid()) @db.Uuid
  parkId   String @db.Uuid
  park     Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  name     String
  district String
  /// Ni `units` ni `occupied` : ce sont des comptages, pas des colonnes. Les
  /// deux se contredisaient déjà entre deux écrans du client.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units Unit[]
  /// Les gestionnaires à qui CET immeuble est confié. Voir `MembershipBuilding`.
  gestionnaires MembershipBuilding[]

  @@index([parkId])
}

model Unit {
  id         String @id @default(uuid()) @db.Uuid
  buildingId String @db.Uuid
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// « A1 ». Lisible et affiché, mais jamais une clé : « A1 » existe dans
  /// presque tous les immeubles du monde.
  label      String
  type       UnitType
  /// Surface en m², entier — le centimètre carré n'a pas d'usage ici.
  surfaceSqm Int
  /// Loyer de référence en unités mineures. L'échéance réelle est figée sur
  /// chaque `RentCharge` : changer le loyer ne doit pas réécrire le passé.
  baseRentMinor Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases      Lease[]
  readings    MeterReading[]
  inspections Inspection[]
  workOrders  WorkOrder[]
  invitations Invitation[]

  @@unique([buildingId, label])
  @@index([buildingId])
  /// Les gestionnaires à qui CE logement est confié. Voir `MembershipUnit`.
  gestionnaires MembershipUnit[]
}

// ─── Locataires et baux ──────────────────────────────────────────────────────

/// Une personne qui loue. Distincte du compte : un locataire existe dès que le
/// propriétaire crée sa fiche, avant même qu'il n'active son espace.
model Tenant {
  id      String @id @default(uuid()) @db.Uuid
  parkId  String @db.Uuid
  park    Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  fullName String
  phoneE164 String?
  email    String?
  /// Renseigné quand l'invitation a été utilisée. Un locataire sans compte
  /// reste un locataire : c'est l'état normal entre la création de sa fiche et
  /// sa première connexion.
  userId  String? @unique @db.Uuid
  user    UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases Lease[]
  reportedWorks WorkOrder[] @relation("WorkReporter")

  @@index([parkId])
}

/// Le bail : la relation datée entre une personne et une unité.
///
/// C'est lui qui répond à « l'unité est-elle occupée ? ». Le client répondait
/// par `Unit.status === 'vacant'`, en mélangeant cette question avec l'état de
/// l'échéance du mois.
model Lease {
  id        String @id @default(uuid()) @db.Uuid
  unitId    String @db.Uuid
  unit      Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId  String @db.Uuid
  /// `NoAction` et non `Restrict`, pour une raison qui n'est pas cosmétique :
  /// les deux refusent de supprimer un locataire cité par un bail — l'intention
  /// —, mais `RESTRICT` est vérifié ligne à ligne, immédiatement, alors que
  /// `NO ACTION` l'est en fin d'instruction. Supprimer un parc échouait donc :
  /// la cascade vers `Tenant` se heurtait au bail avant que la cascade vers
  /// `Unit` n'ait eu le temps de le supprimer. La protection demeure, elle
  /// laisse simplement la cascade se dérouler d'abord.
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction)

  startsOn  DateTime @db.Date
  /// `null` tant que le bail court. C'est ce champ qui rend `Deposit` clé par
  /// bail plutôt que par unité : la caution du locataire suivant écrasait
  /// sinon celle de l'ancien, retenue et solde compris.
  endsOn    DateTime? @db.Date
  rentMinor Int
  /// Jour d'échéance. `overdueDays` était écrit à la main dans le client — 24,
  /// 9, 3 — et ne grandissait jamais. Il se calcule à partir d'ici.
  dueDayOfMonth Int @default(5)
  status    LeaseStatus @default(pending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges     RentCharge[]
  deposit     Deposit?
  inspections Inspection[]
  documentRequests DocumentRequest[]
  reminderEmails RentReminderEmail[]

  @@index([unitId, status])
  @@index([tenantId])
}

/// Une échéance de loyer pour une période donnée.
///
/// C'est l'entité qui manquait le plus. Sans elle, l'écran Paiements
/// **simulait** la part réglée d'un règlement partiel — 53 % du loyer — pendant
/// qu'une alerte annonçait 40 000 pour le même versement : deux chiffres pour
/// un seul fait, parce que le fait n'existait nulle part.
model RentCharge {
  id       String @id @default(uuid()) @db.Uuid
  leaseId  String @db.Uuid
  lease    Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// Premier jour de la période couverte. Une date, pas un couple
  /// année/mois-indexé-à-zéro.
  periodStart DateTime @db.Date
  dueOn    DateTime @db.Date
  rentMinor Int
  /// Charges refacturées, figées à l'émission. Refacturer juillet au tarif
  /// d'août est faux, et rien ne le signalerait.
  ///
  /// Ventilées par fluide : l'histogramme du tableau de bord empile loyer, eau
  /// et électricité. Un total unique obligerait l'écran à inventer la
  /// répartition — ce que faisait la constante `COLLECTIONS`.
  waterMinor Int @default(0)
  powerMinor Int @default(0)
  createdAt DateTime @default(now())

  payments Payment[]

  @@unique([leaseId, periodStart])
  @@index([dueOn])
}

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  chargeId  String @db.Uuid
  charge    RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountMinor Int
  /// Devise dans laquelle CET argent a été reçu.
  ///
  /// Redondante avec `Park.currency` tant qu'un parc n'en change pas — et c'est
  /// exactement le cas qu'elle couvre. Le produit autorise le changement, en
  /// avertissant que « les montants déjà saisis ne seront pas convertis » ; une
  /// quittance rééditée après ce geste portait alors une AUTRE monnaie que celle
  /// déjà remise au locataire, pour le même versement. La devise appartient au
  /// fait, pas au réglage du jour où on l'imprime.
  currency  Currency
  method    PaymentMethod
  paidOn    DateTime @db.Date
  reference String?
  note      String?
  /// Qui a enregistré l'encaissement. Un versement en espèces sans auteur est
  /// incontestable et donc indéfendable.
  recordedById String @db.Uuid
  recordedBy   UserAccount @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt DateTime @default(now())

  @@index([chargeId])
  @@index([paidOn])
}

/// Caution, clé par **bail** et non par unité.
model Deposit {
  id       String @id @default(uuid()) @db.Uuid
  leaseId  String @unique @db.Uuid
  lease    Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  heldMinor     Int
  withheldMinor Int @default(0)
  /// La justification que la modale rend obligatoire dès qu'il y a une retenue
  /// — « un décompte sans motif est indéfendable », dit son propre commentaire
  /// — et que `settleDeposit` jetait. Le seul texte qui défendrait la décision
  /// devant un locataire était le seul qu'on ne conservait pas.
  withheldReason String?
  status   DepositStatus @default(held)
  settledAt DateTime?
  settledById String? @db.Uuid
  settledBy   UserAccount? @relation("DepositSettler", fields: [settledById], references: [id], onDelete: SetNull)
  /// Distinct de `settledAt` : arbitrer n'est pas verser.
  returnedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Terrain ─────────────────────────────────────────────────────────────────

/// Un relevé porte un **index**, pour une unité, un fluide et une période.
///
/// Le client stockait un couple `previous`/`current` par unité : un instantané
/// d'un mois, où `waterPrevious` était la copie d'une ligne qui aurait dû
/// exister. La consommation et l'index précédent se dérivent d'ici.
model MeterReading {
  id       String @id @default(uuid()) @db.Uuid
  unitId   String @db.Uuid
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  utility  Utility
  periodStart DateTime @db.Date
  /// Index au compteur. Entier : ni l'eau ni l'électricité ne se relèvent au
  /// dixième sur ces compteurs.
  indexValue Int
  readAt   DateTime @db.Date
  capturedById String? @db.Uuid
  capturedBy   UserAccount? @relation("ReadingCapturer", fields: [capturedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([unitId, utility, periodStart])
  @@index([periodStart])
}

/// Tarif de refacturation, daté et rattaché à un parc.
///
/// `UTILITY_RATES` était une constante globale. Un tarif change dans le temps,
/// et une ancienne quittance doit rester explicable.
model UtilityTariff {
  id       String @id @default(uuid()) @db.Uuid
  parkId   String @db.Uuid
  park     Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  utility  Utility
  /// Prix unitaire en unités mineures, par m³ ou par kWh.
  unitPriceMinor Int
  effectiveFrom DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([parkId, utility, effectiveFrom])
}

model Inspection {
  id      String @id @default(uuid()) @db.Uuid
  unitId  String @db.Uuid
  unit    Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// Rattaché au bail : une sortie doit être attribuable au locataire qui part
  /// — précisément la personne dont on arbitre la caution. Le client ne
  /// rattachait l'état des lieux qu'à l'unité.
  leaseId String? @db.Uuid
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  kind    InspectionKind
  performedOn DateTime @db.Date
  rooms   Int
  /// `signed: boolean` ne disait ni qui ni quand, alors que c'est le champ
  /// qu'on oppose au locataire en cas de litige.
  signedAt DateTime?
  signedByName String?
  createdAt DateTime @default(now())

  findings InspectionFinding[]

  @@index([unitId])
}

/// Une réserve constatée. Le client n'en comptait que le nombre — or c'est le
/// détail des réserves qu'on chiffre contre la caution.
model InspectionFinding {
  id           String @id @default(uuid()) @db.Uuid
  inspectionId String @db.Uuid
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  room        String
  description String
  severity    FindingSeverity @default(minor)
  /// Coût imputé, figé au moment de l'arbitrage.
  costMinor   Int?

  photos InspectionPhoto[]

  @@index([inspectionId])
}

/// La photo d'une réserve. Une rayure décrite se conteste ; une rayure
/// photographiée et horodatée par le serveur se chiffre.
///
/// Les OCTETS ne sont pas ici : ils vivent dans le dépôt d'objets, sous
/// `storageKey`. Cette table ne porte que ce qui doit être interrogeable,
/// cloisonné et daté — c'est-à-dire tout sauf l'image elle-même.
model InspectionPhoto {
  id        String @id @default(uuid()) @db.Uuid
  findingId String @db.Uuid
  /// CASCADE : une réserve supprimée n'a plus de photo à justifier. Sans elle,
  /// la ligne survivrait à ce qu'elle documente et pointerait vers une clé que
  /// plus rien ne relie à un parc — donc que plus aucun contrôle
  /// d'appartenance ne saurait protéger.
  finding   InspectionFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  /// La clé dans le dépôt d'objets, tirée au hasard sur 128 bits. UNIQUE parce
  /// que deux lignes visant le même objet feraient d'une suppression une fuite
  /// pour l'autre.
  storageKey String @unique

  /// Type et poids. ANNONCÉS par le client à la réservation, REMPLACÉS par ce
  /// que le serveur a mesuré à la confirmation. Tant que `confirmedAt` est nul,
  /// ces deux colonnes ne valent que ce que vaut la parole du déposant — et
  /// c'est exactement pourquoi rien de non confirmé n'est jamais servi.
  contentType String
  sizeBytes   Int

  /// L'HORODATAGE QUI FAIT FOI, posé par le SERVEUR.
  ///
  /// `InspectionFinding` n'a aucune date : une réserve n'est datée que par
  /// l'état des lieux qui la porte. La photo, elle, en a une, et sa valeur en
  /// litige tient entièrement au fait que le client ne l'écrit pas. Une date
  /// venue du téléphone se change dans les réglages du téléphone.
  ///
  /// C'est l'instant où le serveur a CONSTATÉ les octets — le seul dont il
  /// puisse témoigner. Nul tant que rien n'est monté : une réservation n'est
  /// pas une preuve.
  confirmedAt DateTime?

  /// Instant de la réservation. Sert au balayage des réservations mortes.
  createdAt DateTime @default(now())

  @@index([findingId])
  /// Les réservations jamais confirmées se retrouvent par cet index, et c'est
  /// leur seule trace : sans la ligne, un objet monté puis abandonné serait
  /// payé indéfiniment sans que rien ne sache qu'il existe.
  @@index([confirmedAt])
}

// ─── Travaux ─────────────────────────────────────────────────────────────────

model WorkOrder {
  id      String @id @default(uuid()) @db.Uuid
  unitId  String @db.Uuid
  unit    Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// « SIG-2026-042 » : affichée, jamais référencée. Allouée par parc et par
  /// année — voir `WorkReferenceCounter`.
  reference String @unique
  /// Texte libre, écrit par qui signale. Le client avait figé cinq clés de
  /// démonstration ; son propre commentaire annonçait ce champ.
  title       String
  /// Déjà saisie et déjà validée dans le portail locataire — elle n'avait
  /// simplement nulle part où aller.
  description String?
  trade   Trade
  status  WorkStatus @default(reported)
  /// Trois niveaux, comme le formulaire du portail. Le client n'avait qu'un
  /// booléen `urgent`, plus pauvre que le formulaire qui l'alimente.
  urgency Urgency @default(normal)
  quotedAmountMinor Int?
  /// Montant au moment de la validation. Un devis révisé après coup ne doit pas
  /// réécrire ce qui a été engagé.
  approvedAmountMinor Int?
  approvedAt DateTime?
  approvedById String? @db.Uuid
  approvedBy   UserAccount? @relation("WorkApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  completedOn DateTime? @db.Date
  reportedAt DateTime @default(now())
  /// D'où vient l'intervention. Voir `WorkOrigin`.
  ///
  /// `tenantReport` par défaut parce que c'est ce qu'étaient TOUTES les
  /// interventions jusqu'ici : la route n'acceptait la création que par ce
  /// chemin. Le défaut n'est donc pas un choix de commodité, c'est la vérité
  /// des lignes déjà en base.
  origin WorkOrigin @default(tenantReport)
  /// Renseigné quand le signalement vient du portail locataire.
  reportedByTenantId String? @db.Uuid
  /// La RELATION, qui manquait.
  ///
  /// Le champ vivait en `uuid` nu, sans clé étrangère : rien n'empêchait un
  /// identifiant orphelin, et surtout on ne pouvait pas joindre le nom du
  /// déclarant. Il était donc écrit depuis l'origine et lu nulle part — le
  /// bailleur recevait un problème sans savoir qui l'avait vu, ce que le
  /// commentaire de la route promettait pourtant de corriger.
  reportedByTenant Tenant? @relation("WorkReporter", fields: [reportedByTenantId], references: [id], onDelete: SetNull)
  /// Le COMPTE qui a ouvert le chantier, quand ce n'est pas un locataire.
  ///
  /// `reportedByTenantId` ne couvre que la moitié des cas. Quand le bailleur ou
  /// son gestionnaire déclare, l'intervention naissait sans aucun auteur : ni
  /// nom, ni compte, rien à opposer six mois plus tard à « qui a décidé cette
  /// dépense ». `approvedById` existe pour la validation ; celui-ci lui répond
  /// pour l'ouverture.
  reportedById String? @db.Uuid
  reportedBy   UserAccount? @relation("WorkReporterAccount", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  /// La liste se filtre par origine, et le tableau de bord compte les
  /// initiatives du bailleur séparément des signalements.
  @@index([unitId, origin])
  /// Les courriels du fil tentés pour ce chantier. Voir `WorkThreadEmail`.
  threadEmails WorkThreadEmail[]
}

/// Alloue les références lisibles par parc et par année, sans balayer la table.
///
/// Une référence tirée d'un `count()` se duplique dès deux créations
/// simultanées ; un compteur ligne à ligne, verrouillé par la transaction, ne
/// le peut pas.
/**
 * Une pièce administrative demandée par le locataire.
 *
 * Elle n'avait pas d'objet : l'écran « Documents » envoyait la demande par
 * `addWork`, le canal des signalements — le seul que le gestionnaire relève
 * réellement. Elle lui parvenait donc, ce qui valait mieux qu'un toast sans
 * envoi, mais elle arrivait sous la forme d'une INTERVENTION : « Travaux dans
 * mon logement » rangeait « Attestation de résidence » à côté d'une fuite
 * d'évier, avec un métier, une urgence, une référence de chantier et un cycle
 * devis → validation → clôture dont rien ne s'applique à une attestation.
 * Le commentaire de `TenantDocuments.tsx` l'annonçait comme une dette ; la
 * voici soldée.
 *
 * Clé sur le BAIL et non sur l'unité, pour la raison qui a déjà servi à
 * l'historique des quittances : une unité a autant de dossiers que de
 * locataires successifs, et la demande appartient à celui qui l'a faite.
 *
 * Aucune référence lisible — « SIG-2026-042 » — parce qu'on ne se la donne pas
 * au téléphone : une demande de pièce se règle en la fournissant, pas en la
 * citant. Le compteur du parc reste aux interventions.
 */
model DocumentRequest {
  id      String @id @default(uuid()) @db.Uuid
  leaseId String @db.Uuid
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// La pièce demandée, en CLÉ et non en phrase : l'écran la traduit dans la
  /// langue de qui la lit. Le locataire écrit en français, le gestionnaire peut
  /// lire en anglais — figer l'intitulé à l'envoi les enfermerait tous deux
  /// dans la langue du premier.
  kind    DocumentKind
  status  DocumentRequestStatus @default(pending)
  requestedAt DateTime @default(now())
  /// Le compte qui a demandé. `SetNull` : la demande traitée survit à la
  /// fermeture du compte, et le gestionnaire garde la trace de ce qu'il a
  /// fourni.
  requestedById String? @db.Uuid
  requestedBy   UserAccount? @relation("DocumentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  /// Qui a répondu, et quand. Une pièce fournie sans auteur ne se réclame à
  /// personne — c'est le même raisonnement que `Payment.recordedBy`.
  resolvedAt   DateTime?
  resolvedById String? @db.Uuid
  resolvedBy   UserAccount? @relation("DocumentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([leaseId, status])
}

model WorkReferenceCounter {
  parkId String @db.Uuid
  park   Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  year   Int
  next   Int    @default(1)

  @@id([parkId, year])
}

// ─── Notifications et traçabilité ────────────────────────────────────────────

/// Message composé par le produit, en clé et en paramètres.
///
/// Les alertes du client portaient des phrases françaises complètes, chacune
/// figeant en plus une date au format numérique, un montant sans devise et un
/// pluriel concaténé. La correction faite côté client se poursuit ici : la base
/// stocke la clé et les valeurs brutes, la langue est choisie à l'affichage.
model Notification {
  id      String @id @default(uuid()) @db.Uuid
  parkId  String @db.Uuid
  park    Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  kind    NotificationKind
  messageKey String
  /// Valeurs d'interpolation, brutes : un montant reste un nombre, une date
  /// reste une date.
  params  Json
  severity NotificationSeverity @default(low)
  /// Unité concernée, pour le cloisonnement du locataire.
  unitId  String? @db.Uuid
  /// Canal réellement emprunté. La grille tarifaire vend les relances
  /// automatiques J+1/J+7/J+15 : sans trace d'envoi, le produit relancerait
  /// deux fois le même locataire le même jour.
  channel NotificationChannel @default(in_app)
  sentAt  DateTime?
  createdAt DateTime @default(now())

  recipients NotificationRecipient[]

  @@index([parkId, createdAt])
  /// Les copies e-mail de CE message. Voir `WorkThreadEmail`.
  threadEmails WorkThreadEmail[]
}

/// L'état « lu » appartient à un couple destinataire × notification.
///
/// Le client le tenait dans un `Set` de session, invisible de la barre latérale
/// — la pastille annonçait « 2 » même après avoir tout marqué comme lu.
model NotificationRecipient {
  notificationId String @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  readAt DateTime?

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

/// Trace d'ENVOI d'une relance automatique par e-mail, un jalon à la fois.
///
/// Distincte de `Notification` par nécessité, pas par goût. `Notification`
/// porte le bail dans `params`, du JSON libre sans colonne : aucune contrainte
/// UNIQUE fiable ne peut s'y adosser. Or la garde de ce lot est justement une
/// contrainte UNIQUE — `@@unique([leaseId, sentOn])` — parce qu'une lecture
/// suivie d'une écriture ne protège pas contre deux exécutions SIMULTANÉES :
/// les deux liraient « pas encore envoyé » avant que l'une n'écrive. Un
/// planificateur qui double ses envois est pire que pas de planificateur.
///
/// `leaseId` est donc une colonne réelle, et la course se tranche en base :
/// l'INSERT perdant lève une violation de contrainte (P2002), que l'appelant
/// interprète comme « déjà pris en charge aujourd'hui » plutôt que comme une
/// erreur.
/// La TRACE d'un courriel du fil — signalement, réponse, réponse du locataire.
///
/// « Le courriel du 3 septembre est-il parti ? » ne se répondait qu'en lisant
/// les journaux, qui tournent. Même règle que `RentReminderEmail` :
/// `deliveredAt` reste nul tant que la messagerie n'a pas rendu vrai — une date
/// posée par avance ferait mentir le dossier le jour où quelqu'un contestera
/// avoir été prévenu. La tentative se consigne toujours.
model WorkThreadEmail {
  id        String    @id @default(uuid()) @db.Uuid
  workId    String    @db.Uuid
  work      WorkOrder @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// L'adresse visée. Elle vit déjà ailleurs en base (compte ou fiche) ; la
  /// figer ici dit à QUI la tentative s'adressait ce jour-là, même si
  /// l'adresse du compte change ensuite.
  recipient String
  /// LE MESSAGE que cette copie accompagne, quand il y en a un. Nul pour le
  /// SIGNALEMENT lui-même : il EST le fil, et son avis s'écrit après la copie.
  /// Sans ce lien, « 3 copies remises » ne disait pas lesquelles, et la date
  /// rendue était la dernière tentative tous messages confondus.
  notificationId String? @db.Uuid
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  deliveredAt DateTime?
  createdAt DateTime  @default(now())

  @@index([workId])
}

model RentReminderEmail {
  id        String   @id @default(uuid()) @db.Uuid
  leaseId   String   @db.Uuid
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// Jours de retard au moment de la tentative — 7 pour ce lot, 1 et 15
  /// rejoindront la colonne le jour où leur cadence sera construite.
  milestone Int
  /// Jour UTC de la tentative, borne de l'idempotence quotidienne.
  sentOn    DateTime @db.Date
  /// `null` tant que `envoyerEmail` n'a pas rendu `true` — même règle que
  /// `Notification.sentAt` : une date posée par avance ferait mentir le
  /// dossier le jour où un locataire contestera avoir été prévenu.
  deliveredAt DateTime?
  createdAt DateTime @default(now())

  @@unique([leaseId, sentOn])
}

/// Piste d'audit des décisions engageantes.
///
/// Valider un devis engage une dépense ; arbitrer une caution retient l'argent
/// de quelqu'un. Ces deux droits séparent le propriétaire du gestionnaire, et
/// le client les appliquait par un `canApprove` qui masquait un bouton.
model AuditEvent {
  id      String @id @default(uuid()) @db.Uuid
  parkId  String @db.Uuid
  park    Park   @relation(fields: [parkId], references: [id], onDelete: Cascade)
  actorId String? @db.Uuid
  actor   UserAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action  String
  entity  String
  entityId String @db.Uuid
  /// Ce qui a changé, avant/après. `Json` et non des colonnes : la forme varie
  /// selon l'action, et figer un schéma ici reviendrait à le refaire à chaque
  /// nouvelle décision traçable.
  payload Json?
  createdAt DateTime @default(now())

  @@index([parkId, createdAt])
  @@index([entity, entityId])
}

// ─── Vocabulaires ────────────────────────────────────────────────────────────

enum Locale {
  fr
  en
}

/// Codes ISO 4217. `CFA` du client se résout en `XAF` ou `XOF` selon le pays :
/// il n'existe pas de code commun aux deux zones, et l'affichage les réunit
/// sous « FCFA ».
enum Currency {
  XAF
  XOF
  EUR
  CAD
  USD
}

enum ParkRole {
  owner
  manager
  tenant
}

enum MembershipStatus {
  active
  requested
  revoked
}

/// Ce qu'une adhésion de gestion COUVRE, et il fallait un troisième état.
///
/// Le modèle ne savait dire que « borné » ou « pas borné » : une liste vide
/// VOULAIT dire « pas de restriction ». « Ce cabinet arrive, je ne lui ai encore
/// rien donné » ne pouvait donc pas s'écrire — alors que c'est l'état de tout
/// gestionnaire à sa première minute.
///
/// `wholePark` est le défaut des adhésions D'AVANT : les aveugler à la seconde
/// du déploiement était ce que la règle d'origine refusait, et ce refus reste
/// juste. `declared` est celui des adhésions qui NAISSENT, et une liste vide y
/// veut dire vide.
enum ScopeMode {
  wholePark
  declared
}

enum DelegationMode {
  solo
  delegate
}

/// Typologie du logement. Notation française conservée comme clé — l'anglais la
/// rend « Studio », « 1-bed »… — exactement comme côté client.
enum UnitType {
  T1
  T2
  T3
  T4
}

enum LeaseStatus {
  pending
  active
  ended
}

enum PaymentMethod {
  mobile
  cash
  transfer
  check
}

enum DepositStatus {
  held
  settling
