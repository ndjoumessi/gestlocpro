{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "src/design-system/theme.test.ts",
    "src/design-system/chasseFixe.test.ts",
    "src/design-system/altitudes.test.ts",
    "src/design-system/anneauEtJauge.test.ts",
    "src/design-system/cibles.test.ts",
    "src/design-system/couches.test.ts", "src/design-system/appariements.test.ts", "src/design-system/graisses.test.ts",
    "src/design-system/gouttiere.test.ts",
    "src/design-system/durees.test.ts",
    "src/design-system/ecarts.test.ts",
    "src/design-system/empilement.test.ts",
    "src/design-system/accentDonnee.test.ts",
    "src/design-system/rayons.test.ts",
    "src/design-system/branchesMortes.test.ts",
    "src/design-system/paletteAffichee.test.ts",
    "src/design-system/modales.test.ts",
    "src/design-system/longueurs-recopiees.test.ts",
    "src/design-system/plancher.test.ts",
    "src/design-system/rognage.test.ts",
    "src/design-system/squelette.test.ts",
    "src/design-system/separateurs.test.ts",
    "src/lib/datesISO.test.ts",
    "src/design-system/bandeInversee.test.ts",
    "src/design-system/jetonsMorts.test.ts",
    "src/design-system/squelettesFideles.test.ts",
    "src/design-system/zonesSures.test.ts",
    "src/test/attentesObservees.test.ts",
    "src/test/budgetsDHorloge.test.ts"
  ]
