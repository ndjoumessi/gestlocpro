{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Alias de chemin — doit rester aligné sur vite.config.ts */
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],

  /* Ces tests-ci LISENT des fichiers sur le disque : ils s'exécutent sous Node,
     pas dans le navigateur, et relèvent donc du projet `tsconfig.node.json`.
     Les y renvoyer évite d'ouvrir les types Node à tout le code d'application,
     où `process` et `Buffer` n'ont rien à faire. */
  "exclude": [
    "src/design-system/theme.test.ts",
    "src/design-system/chasseFixe.test.ts",
    "src/design-system/altitudes.test.ts",
    "src/design-system/cibles.test.ts",
    "src/design-system/couches.test.ts", "src/design-system/appariements.test.ts", "src/design-system/graisses.test.ts",
    "src/design-system/gouttiere.test.ts",
    "src/design-system/durees.test.ts",
    "src/design-system/empilement.test.ts",
    "src/design-system/orDonnee.test.ts",
    "src/design-system/paletteAffichee.test.ts",
    "src/design-system/plancher.test.ts",
    "src/design-system/rognage.test.ts",
    "src/design-system/squelette.test.ts",
    "src/design-system/zonesSures.test.ts"
  ]
}
